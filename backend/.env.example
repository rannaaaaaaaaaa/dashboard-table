NODE_ENV=development
PORT=8080

# URL(s) del frontend permitidas por CORS y destino del redirect post-login.
# En Railway poné la URL de Cloudflare Pages. Varias separadas por coma.
FRONTEND_URL=https://tu-panel.pages.dev
FRONTEND_HOME_URL=https://tu-panel.pages.dev

# Cookies de sesión firmadas (cookie-session). Generá algo random y largo.
SESSION_SECRET=cambiame-por-algo-random-y-largo

# Discord OAuth2 + Bot (Developer Portal > tu app)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Debe ser EXACTO: https://TU-BACKEND.up.railway.app/auth/callback
DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback
DISCORD_BOT_TOKEN=

# Opcional: ruta del sqlite. Por defecto backend/data/dashboard.sqlite3
# DB_PATH=/data/dashboard.sqlite3
